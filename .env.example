# ==============================================================================
# NutriGuard Production Environment Variables
# ==============================================================================
# IMPORTANT: Do NOT use these values in production. Generate real secrets.

# Backend (Render Web Service)
DATABASE_URL=postgresql://nutriguard_user:CHANGE_ME@your-db-host:5432/nutriguard
GEMINI_API_KEY=
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE-THIS-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://nutriguard.vercel.app,http://localhost:5173
PORT=8000
ENVIRONMENT=production

# Frontend (Vercel)
# If Vercel rewrites in vercel.json proxy /api/v1/* to Render, VITE_API_URL can be omitted.
# If connecting directly to Render backend:
# VITE_API_URL=https://nutriguard-api.onrender.com
