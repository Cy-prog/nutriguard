# ==============================================================================
# NutriGuard Production Environment Variables
# ==============================================================================

# Backend (Render Web Service)
DATABASE_URL=postgresql://nutriguard_user:password@nutriguard-db:5432/nutriguard
GEMINI_API_KEY=
JWT_SECRET=production-secret-key-minimum-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=https://nutriguard.vercel.app,http://localhost:5173
PORT=8000
ENVIRONMENT=production

# Frontend (Vercel)
# If Vercel rewrites in vercel.json are used, VITE_API_URL can be omitted.
# If connecting directly to Render:
VITE_API_URL=https://nutriguard-api.onrender.com
