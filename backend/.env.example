# ==============================================================================
# NutriGuard Backend Environment Variables Specification
# ==============================================================================

# Database Connection (SQLite for local development, PostgreSQL for Render production)
# Render Internal PostgreSQL example: postgresql://nutriguard_user:password@dpg-xxxxx:5432/nutriguard
DATABASE_URL=sqlite:///./nutriguard.db

# AI Provider Configuration (Google Gemini 1.5/2.0 Flash)
# Optional: If omitted, NutriGuard executes deterministic keyword/rule fallback with zero degradation.
GEMINI_API_KEY=

# Authentication & Security
# Generate using: openssl rand -hex 32
JWT_SECRET=your-32-character-random-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Network & Cross-Origin Resource Sharing (CORS)
# Comma-separated list of approved frontend origins. Do NOT use '*' in production.
CORS_ORIGINS=https://nutriguard.vercel.app,http://localhost:5173,http://localhost:3000

# Application Runtime Configuration
ENVIRONMENT=development
DEBUG=false
PORT=8000
